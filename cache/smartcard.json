":"text"}],"type":"paragraph"}],"introducedVersion":"10.12.4","name":"oneCardPerUser","required":false,"type":[{"kind":"text","text":"boolean"}]},{"attributes":[{"kind":"default","value":"0"},{"kind":"allowedValues","values":["0","1"]}],"content":[{"inlineContent":[{"text":"If ","type":"text"},{"code":"1","type":"codeVoice"},{"text":", the device enables the screen saver when the user removes the smart card.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Available: macOS 10.13.4+","type":"text"}],"type":"paragraph"}],"introducedVersion":"10.12.4","name":"tokenRemovalAction","required":false,"type":[{"kind":"text","text":"integer"}]},{"attributes":[{"kind":"default","value":"true"}],"content":[{"inlineContent":[{"text":"If ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", users don’t get the pairing dialog, although existing pairings still work.","type":"text"}],"type":"paragraph"}],"introducedVersion":"10.12.4","name":"UserPairing","required":false,"type":[{"kind":"text","text":"boolean"}]}],"kind":"properties","title":"Properties"},{"content":[{"anchor":"Discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Specify ","type":"text"},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"text":" as the payload type.","type":"text"}],"type":"paragraph"},{"anchor":"Profile-availability","level":3,"text":"Profile availability","type":"heading"},{"extendedData":{"0_0":{"colspan":0,"rowspan":1},"0_1":{"colspan":0,"rowspan":1}},"header":"row","rows":[[[{"inlineContent":[],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Device channel","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"macOS","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"User channel","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"N\/A","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Allow manual install","type":"text"}],"t