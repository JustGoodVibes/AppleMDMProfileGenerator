{"abstract":[{"text":"The payload that configures a smart card.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies","doc:\/\/com.apple.devicemanagement\/documentation\/DeviceManagement"]]},"identifier":{"interfaceLanguage":"data","url":"doc:\/\/com.apple.devicemanagement\/documentation\/DeviceManagement\/SmartCard"},"kind":"symbol","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"externalID":"mdm-profiles:SmartCard","fragments":[{"kind":"text","text":"object "},{"kind":"identifier","text":"SmartCard"}],"modules":[{"name":"Device Management"}],"navigatorTitle":[{"kind":"identifier","text":"SmartCard"}],"platforms":[{"beta":false,"introducedAt":"10.12.4","name":"macOS"}],"role":"symbol","roleHeading":"Device Management Profile","symbolKind":"dictionary","title":"SmartCard"},"primaryContentSections":[{"declarations":[{"languages":["data"],"platforms":["macOS"],"tokens":[{"kind":"text","text":"object "},{"kind":"identifier","text":"SmartCard"}]}],"kind":"declarations"},{"items":[{"attributes":[{"kind":"default","value":"true"}],"content":[{"inlineContent":[{"text":"If ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", the system disables smart cards for logins, authorizations, and screen saver unlocking. It’s still allowed for other functions, such as signing emails and accessing the web. The device requires a restart for a setting change to take effect.","type":"text"}],"type":"paragraph"}],"introducedVersion":"10.12.4","name":"allowSmartCard","required":false,"type":[{"kind":"text","text":"boolean"}]},{"attributes":[{"kind":"default","value":"0"},{"kind":"allowedValues","values":["0","1","2","3"]}],"content":[{"inlineContent":[{"text":"Configures the certificate trust check and has one of the following possibl