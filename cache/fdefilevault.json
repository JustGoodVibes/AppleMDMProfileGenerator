{"abstract":[{"text":"The payload that configures FileVault.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies","doc:\/\/com.apple.devicemanagement\/documentation\/DeviceManagement"]]},"identifier":{"interfaceLanguage":"data","url":"doc:\/\/com.apple.devicemanagement\/documentation\/DeviceManagement\/FDEFileVault"},"kind":"symbol","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"externalID":"mdm-profiles:FDEFileVault","fragments":[{"kind":"text","text":"object "},{"kind":"identifier","text":"FDEFileVault"}],"modules":[{"name":"Device Management"}],"navigatorTitle":[{"kind":"identifier","text":"FDEFileVault"}],"platforms":[{"beta":false,"introducedAt":"10.9","name":"macOS"}],"role":"symbol","roleHeading":"Device Management Profile","symbolKind":"dictionary","title":"FDEFileVault"},"primaryContentSections":[{"declarations":[{"languages":["data"],"platforms":["macOS"],"tokens":[{"kind":"text","text":"object "},{"kind":"identifier","text":"FDEFileVault"}]}],"kind":"declarations"},{"items":[{"attributes":[],"content":[{"inlineContent":[{"text":"The DER-encoded certificate data if the system creates an institutional recovery key. This key isn’t supported on a Mac with Apple silicon.","type":"text"}],"type":"paragraph"}],"introducedVersion":"10.9.0","name":"Certificate","required":false,"type":[{"kind":"text","text":"data"}]},{"attributes":[{"kind":"default","value":"false"}],"content":[{"inlineContent":[{"text":"If ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", the system defers enabling FileVault until the designated user logs out. For details, see ","type":"text"},{"code":"fdesetup(8)","type":"codeVoice"},{"text":". Only a local user or a mobile account user can enable FileVault.","type":"text"}],"type":"paragraph"}],"introducedVersion":"10.9.0","name":"Defer","required":false,"type":[{"kind":"text","text":"boolean"}]},{"attributes":[{"kind":"default","value":"false"}],"content":[{"inlineContent":[{"text":"If ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", the system prevents requests to enable FileVault at user logout time.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Available: macOS 10.10+","type":"text"}],"type":"paragraph"}],"introducedVersion":"10.9.0","name":"DeferDontAskAtUserLogout","required":false,"type":[{"kind":"text","text":"boolean"}]},{"attributes":[{"kind":"minimum","value":"-1"},{"kind":"maximum","value":"9999"}],"content":[{"inlineContent":[{"text":"The maximum number of times users can bypass enabling FileVault before the system requires the user to enable it to log in. If the value is ","type":"text"},{"code":"0","type":"codeVoice"},{"text":", the system requires the user to enable FileVault the next time they attempt to log in. Set this key to ","type":"text"},{"code":"-1","type":"codeVoice"},{"text":" to disable this feature.","type":"text"}],"type":"paragraph"}],"introducedVersion":"10.9.0","name":"DeferForceAtUserLoginMaxBypassAttempts","required":false,"type":[{"kind":"text","text":"integer"}]},{"attributes":[{"kind":"allowedValues","values":["On","Off"]}],"content":[{"inlineContent":[{"text":"Set to ","type":"text"},{"code":"On","type":"codeVoice"},{"text":" to enable FileVault and set to ","type":"text"},{"code":"Off","type":"codeVoice"},{"text":" to disable FileVault. Payloads set to ","type":"text"},{"code":"On","type":"codeVoice"},{"text":" sent through MDM need to either include full authentication information in the payload or have the ","type":"text"},{"code":"Defer","type":"codeVoice"},{"text":" option set to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":". When ","type":"text"},{"code":"Defer","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", the system prompts for the authentication information when the user enables FileVault.","type":"text"}],"type":"paragraph"}],"introducedVersion":"10.9.0","name":"Enable","required":true,"type":[{"kind":"text","text":"string"}]},{"attributes":[{"kind":"default","value":"false"}],"content":[{"inlineContent":[{"text":"If ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", and installation of this payload occurs after enrolling with MDM in Setup Assistant, the system requests Setup Assistant to enable FileVault at setup time.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To use this, enable the Await Device Configured ADE configuration option and send this profile with this key set, before sending the ","type":"text"},{"identifier":"doc:\/\/com.apple.devicemanagement\/documentation\/DeviceManagement\/DeviceConfiguredCommand","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"An admin SecureToken user is required, otherwise the FileVault pane doesn’t appear.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Available: macOS 14+","type":"text"}],"type":"paragraph"}],"introducedVersion":"10.9.0","name":"ForceEnableInSetupAssistant","required":false,"type":[{"kind":"text","text":"boolean"}]},{"attributes":[],"content":[{"inlineContent":[{"text":"The path to the location of the recovery key and computer information property list.","type":"text"}],"type":"paragraph"}],"introducedVersion":"10.9.0","name":"OutputPath","required":false,"type":[{"kind":"text","text":"string"}]},{"attributes":[],"content":[{"inlineContent":[{"text":"The password of the Open Directory user to add to FileVault. Use the ","type":"text"},{"code":"UserEntersMissingInfo","type":"codeVoice"},{"text":" key to prompt for this information.","type":"text"}],"type":"paragraph"}],"introducedVersion":"10.9.0","name":"Password","required":false,"type":[{"kind":"text","text":"string"}]},{"attributes":[],"content":[{"inlineContent":[{"text":"The UUID of the payload within the same profile containing the asymmetric recovery key certificate payload.","type":"text"}],"type":"paragraph"}],"introducedVersion":"10.9.0","name":"PayloadCertificateUUID","required":false,"type":[{"kind":"text","text":"string"}]},{"attributes":[{"kind":"default","value":"true"}],"content":[{"inlineContent":[{"text":"If ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", the system prevents display of the personal recovery key to the user after the system enables FileVault.","type":"text"}],"type":"paragraph"}],"introducedVersion":"10.9.0","name":"ShowRecoveryKey","required":false,"type":[{"kind":"text","text":"boolean"}]},{"attributes":[{"kind":"default","value":"false"}],"content":[{"inlineContent":[{"text":"If ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" and you don’t include certificate information in this payload, the system uses the keychain created at ","type":"text"},{"code":"\/Library\/Keychains\/FileVaultMaster.keychain","type":"codeVoice"},{"text":" when it adds the institutional recovery key.","type":"text"}],"type":"paragraph"}],"introducedVersion":"10.9.0","name":"UseKeychain","required":false,"type":[{"kind":"text","text":"boolean"}]},{"attributes":[{"kind":"default","value":"true"}],"content":[{"inlineContent":[{"text":"If ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", the system creates a personal recovery key and displays it to the user.","type":"text"}],"type":"paragraph"}],"introducedVersion":"10.9.0","name":"UseRecoveryKey","required":false,"type":[{"kind":"text","text":"boolean"}]},{"attributes":[{"kind":"default","value":"false"}],"content":[{"inlineContent":[{"text":"If ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", the system enables a prompt for missing user name or password fields.","type":"text"}],"type":"paragraph"}],"introducedVersion":"10.9.0","name":"UserEntersMissingInfo","required":false,"type":[{"kind":"text","text":"boolean"}]},{"attributes":[],"content":[{"inlineContent":[{"text":"The user name of the Open Directory user to add to FileVault.","type":"text"}],"type":"paragraph"}],"introducedVersion":"10.9.0","name":"Username","required":false,"type":[{"kind":"text","text":"string"}]}],"kind":"properties","title":"Properties"},{"content":[{"anchor":"Discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Specify ","type":"text"},{"code":"com.apple.MCX.FileVault2","type":"codeVoice"},{"text":" as the payload type.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"FileVault 2 performs full XTS-AES 128 encryption on the contents of a volume. Removing the FileVault payload doesn’t disable FileVault.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"As of macOS 10.15, FileVault settings require supervision or user approval when installed manually.","type":"text"}],"type":"paragraph"},{"anchor":"Profile-availability","level":3,"text":"Profile availability","type":"heading"},{"extendedData":{"0_0":{"colspan":0,"rowspan":1},"0_1":{"colspan":0,"rowspan":1}},"header":"row","rows":[[[{"inlineContent":[],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Device channel","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"macOS","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"User channel","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"N\/A","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Allow manual install","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"macOS","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Requires supervision","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"N\/A","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Requires user-approved MDM","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"macOS","type":"tex